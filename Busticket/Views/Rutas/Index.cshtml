@model List<Busticket.Models.Ruta>

@{
    ViewBag.Title = "Rutas";
    Layout = null;

    var destinoSeleccionado = Context.Request.Query["destino"].ToString();
}
<partial name="_DarkModeScript" />

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="~/css/ModeDark.css" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .fade-up { animation: fadeUp .6s ease-out forwards; }

        .header-scrolled {
            background: rgba(255,255,255,0.85) !important;
            backdrop-filter: blur(16px);
            box-shadow: 0 1px 0 rgba(0,0,0,0.06);
        }
        .profile-dropdown { display: none; }
        .profile-dropdown.open { display: block; }
    </style>
</head>

<!-- HEADER -->
<header id="header" class="fixed top-0 inset-x-0 z-50 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-10 py-5 flex items-center justify-between">

        <!-- IZQUIERDA: volver + logo -->
        <div class="flex items-center gap-5">
            <button onclick="history.back()"
                    class="flex items-center gap-1.5 text-xs tracking-widest uppercase text-gray-500
                           hover:text-gray-900 transition-colors group">
                <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform duration-200"
                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                </svg>
                Volver
            </button>
            <div class="w-px h-4 bg-gray-200"></div>
            <a href="/Home/Index" class="text-xl tracking-widest uppercase font-semibold text-gray-900">
                Busticket
            </a>
        </div>

        <!-- DERECHA -->
        <nav class="hidden md:flex gap-8 text-xs tracking-widest uppercase items-center text-gray-700">
            <a href="/Ayuda"
               class="relative after:absolute after:left-0 after:-bottom-1 after:w-0 after:h-px
                      after:bg-gray-900 after:transition-all after:duration-300 hover:after:w-full hover:text-gray-900 transition-colors">
                Ayuda
            </a>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="relative" id="profileWrapper">
                    <button onclick="toggleDropdown()"
                            class="flex items-center justify-center w-9 h-9 rounded-full border border-gray-300
                                   hover:bg-gray-900 hover:text-white hover:border-gray-900 transition-all duration-200">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </button>

                    <div id="profileDropdown"
                         class="profile-dropdown absolute right-0 mt-3 w-48 bg-white border border-gray-100
                                rounded-2xl overflow-hidden shadow-xl shadow-gray-200/60">
                        <a href="/Perfil"
                           class="flex items-center gap-3 px-5 py-3.5 text-sm text-gray-700 hover:bg-gray-50
                                  transition-colors normal-case tracking-normal font-normal">
                            <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            Mi perfil
                        </a>
                        <div class="h-px bg-gray-100"></div>
                        <form asp-controller="Auth" asp-action="Logout" method="post">
                            <button type="submit"
                                    class="w-full flex items-center gap-3 px-5 py-3.5 text-sm text-red-500
                                           hover:bg-red-50 transition-colors normal-case tracking-normal font-normal">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                                </svg>
                                Cerrar sesión
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <a href="/Auth/Login"
                   class="relative after:absolute after:left-0 after:-bottom-1 after:w-0 after:h-px
                          after:bg-gray-900 after:transition-all after:duration-300 hover:after:w-full hover:text-gray-900 transition-colors">
                    Iniciar sesión
                </a>
            }

            @if (User.IsInRole("Admin"))
            {
                <a href="/Admin/Index"
                   class="relative after:absolute after:left-0 after:-bottom-1 after:w-0 after:h-px
                          after:bg-gray-900 after:transition-all after:duration-300 hover:after:w-full hover:text-gray-900 transition-colors">
                    Admin
                </a>
            }
            @if (User.IsInRole("Empresa"))
            {
                <a href="/PanelEmpresa/Index"
                   class="relative after:absolute after:left-0 after:-bottom-1 after:w-0 after:h-px
                          after:bg-gray-900 after:transition-all after:duration-300 hover:after:w-full hover:text-gray-900 transition-colors">
                    Empresa
                </a>
            }
        </nav>

        <button id="menuBtn" class="md:hidden text-xl text-gray-700 z-50">☰</button>
    </div>
</header>

<!-- MENÚ MÓVIL -->
<div id="mobileMenu" class="fixed inset-0 bg-black/90 backdrop-blur-sm flex flex-col items-center justify-center
        space-y-8 uppercase tracking-widest text-lg transform -translate-y-full
        transition-transform duration-500 md:hidden z-40 text-white">
    <a href="/Ayuda">Ayuda</a>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a href="/Perfil">Mi perfil</a>
        <form asp-controller="Auth" asp-action="Logout" method="post">
            <button type="submit">Cerrar sesión</button>
        </form>
    }
    else { <a href="/Auth/Login">Iniciar sesión</a> }
    @if (User.IsInRole("Admin")) { <a href="/Admin/Index">Admin</a> }
    @if (User.IsInRole("Empresa")) { <a href="/PanelEmpresa/Index">Empresa</a> }
</div>

<body class="bg-[#f7f8fa] text-gray-800">

  
    
    <!-- CONTENIDO -->
    <main class="w-full max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-10 pt-28 pb-16">

        <!-- TÍTULO DINÁMICO -->
        <div class="text-center mb-14 fade-up">
            @if (!string.IsNullOrEmpty(destinoSeleccionado))
            {
                <p class="text-xs uppercase tracking-widest text-gray-500">
                    Rutas disponibles hacia
                </p>
                <h1 class="text-3xl sm:text-4xl font-semibold text-gray-900 mt-2">
                    @destinoSeleccionado
                </h1>
            }
            else
            {
                <h1 class="text-3xl sm:text-4xl font-semibold text-gray-900">
                    Destinos populares
                </h1>
                <p class="text-sm text-gray-500 mt-2">
                    Aquí comienza tu próxima aventura
                </p>
            }
        </div>

        <!-- GRID DE DESTINOS -->
        @if (string.IsNullOrEmpty(destinoSeleccionado))
        {
            <section class="
            grid
            grid-cols-1
            sm:grid-cols-2
            lg:grid-cols-3
            xl:grid-cols-4
            gap-6 lg:gap-8
        ">
                @{
                    var index = 0;
                }

                @foreach (var grupo in Model
                            .GroupBy(r => r.CiudadDestino)
                            .Select(g => new
                            {
                                Ciudad = g.Key,
                                PrecioMin = g.Min(r => r.Precio),
                                RutaEjemplo = g.First()
                            }))
                {
                    <article class="
                            group relative
                            h-[260px] sm:h-[300px]
                            rounded-2xl
                            overflow-hidden
                            cursor-pointer
                            shadow-md hover:shadow-2xl
                            transition-all duration-500
                            hover:-translate-y-1
                            fade-up
                        "
                             style="animation-delay:@(index * 0.05)s"
                             onclick="location.href='/Rutas/Listado?destino=@grupo.Ciudad.Nombre'">

                        <!-- IMAGEN -->
                        <img src="@(grupo.RutaEjemplo.ImagenUrl ??
                                                 $"https://picsum.photos/seed/{grupo.Ciudad.Nombre}/600/400")"
                             class="absolute inset-0 w-full h-full object-cover z-0
                             transition-transform duration-700 group-hover:scale-110" />

                        <!-- OVERLAY -->
                        <div class="absolute inset-0 bg-gradient-to-t
                            from-black/70 via-black/30 to-transparent z-10">
                        </div>

                        <!-- CONTENIDO TEXTO -->
                        <div class="absolute bottom-0 w-full p-5 text-white z-20">

                            <h3 class="text-lg sm:text-xl font-semibold !text-white drop-shadow-xl">
                                @grupo.Ciudad.Nombre
                            </h3>

                            <p class="text-sm !text-white mt-1 drop-shadow-xl">
                                Desde $@grupo.PrecioMin
                            </p>

                        </div>

                    </article>

                    index++;
                }
            </section>
        }

    </main>

    @* Script para abrir /cerrar el menú móvil  *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const menuBtn = document.getElementById("menuBtn");
            const mobileMenu = document.getElementById("mobileMenu");

            let isOpen = false;

            menuBtn.addEventListener("click", function () {

                isOpen = !isOpen;

                if (isOpen) {
                    mobileMenu.classList.remove("-translate-y-full");
                    menuBtn.textContent = "✕";
                } else {
                    mobileMenu.classList.add("-translate-y-full");
                    menuBtn.textContent = "☰";
                }

            });

        });
    </script>

</body>
</html>
