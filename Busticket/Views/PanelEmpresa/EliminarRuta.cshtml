@model Busticket.Models.Ruta
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Busticket | Eliminar Ruta</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-[#f7f8fa] text-gray-800">
<partial name="_SharedHeader" />
<main class="max-w-screen-lg mx-auto px-4 sm:px-6 lg:px-10 pt-28 pb-16">

    <div class="max-w-md mx-auto">
        <!-- Back link -->
        <a asp-controller="PanelEmpresa" asp-action="Rutas"
           class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            Volver a Rutas
        </a>

        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-6">Panel Empresa / Rutas</p>
            <h1 class="text-2xl font-bold text-gray-900 mb-6">Eliminar ruta</h1>

            <!-- Route info -->
            <div class="flex items-center gap-3 mb-6">
                <span class="text-sm font-semibold text-gray-700">@Model.CiudadOrigen?.Nombre</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
                <span class="text-sm font-semibold text-gray-700">@Model.CiudadDestino?.Nombre</span>
            </div>

            <!-- Warning -->
            <div class="bg-red-50 border border-red-100 rounded-2xl px-4 py-3 mb-8">
                <p class="text-sm text-red-600 font-medium">Esta accion no se puede deshacer. La ruta sera eliminada de forma permanente.</p>
            </div>

            <form asp-controller="PanelEmpresa" asp-action="EliminarRuta" method="post" class="space-y-3">
                <input type="hidden" asp-for="RutaId" />

                <button type="submit"
                        class="w-full bg-red-500 text-white py-3 rounded-2xl text-sm font-semibold hover:bg-red-600 transition-colors">
                    Eliminar ruta
                </button>
                <a asp-controller="PanelEmpresa" asp-action="Rutas"
                   class="flex items-center justify-center w-full border border-gray-200 text-gray-600 py-3 rounded-2xl text-sm font-medium hover:bg-gray-50 transition-colors">
                    Cancelar
                </a>
            </form>
        </div>
    </div>

</main>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const success = '@TempData["SuccessMessage"]';
        const error   = '@TempData["ErrorMessage"]';
        if (success && success.trim()) Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: success, showConfirmButton: false, timer: 2500 });
        if (error   && error.trim())   Swal.fire({ toast: true, position: 'top-end', icon: 'error',   title: error,   showConfirmButton: false, timer: 3000 });
    });
</script>
</body>
</html>
