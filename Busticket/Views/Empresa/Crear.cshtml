@model Busticket.Models.Empresa

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

<partial name="_SharedHeader" />

<!-- FORM -->
<div class="max-w-3xl mx-auto pt-28 pb-10 px-4 bg-white p-8 rounded-2xl shadow-lg">
    <h1 class="text-3xl font-bold mb-6">Crear Empresa</h1>

    <form asp-action="Crear" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-red-600 mb-4"></div>

        <!-- NOMBRE -->
        <div class="mb-4">
            <label class="block text-sm font-semibold mb-1">Nombre</label>
            <input asp-for="Nombre"
                   class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-black" />
        </div>

        <!-- NIT -->
        <div class="mb-4">
            <label class="block text-sm font-semibold mb-1">NIT</label>
            <input asp-for="Nit"
                   class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-black" />
        </div>

        <!-- EMAIL -->
        <div class="mb-4">
            <label class="block text-sm font-semibold mb-1">Email</label>
            <input asp-for="Email" type="email"
                   class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-black" />
        </div>

        <!-- PAIS -->
        <div class="mb-4">
            <label class="block text-sm font-semibold mb-1">País</label>
            <input asp-for="Pais"
                   class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-black" />
        </div>

        <!-- TELEFONO -->
        <div class="mb-6">
            <label class="block text-sm font-semibold mb-1">Teléfono</label>
            <input asp-for="Telefono"
                   class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-black" />
        </div>

        <!-- BOTÓN -->
        <button type="submit"
                class="w-full bg-black text-white py-3 rounded-lg
                       hover:bg-gray-800 transition font-semibold">
            Crear Empresa
        </button>
    </form>
</div>

</body>
</html>