@model Busticket.Models.PerfilViewModel
@{
    Layout = null;
    var initials = string.Join("", (Model.Nombre ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2).Select(w => char.ToUpper(w[0])));
    if (string.IsNullOrWhiteSpace(initials)) initials = "U";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Busticket | Mi perfil</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-[#f7f8fa] text-gray-800">

<partial name="_SharedHeader" />

<main class="max-w-screen-lg mx-auto px-4 sm:px-6 lg:px-10 pt-28 pb-16">

    <div class="mb-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-1">Cuenta</p>
        <h1 class="text-2xl font-bold text-gray-900">Mi perfil</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-6 items-start">

        <!-- ── SIDEBAR ───────────────────────────────────────────── -->
        <aside class="space-y-4">

            <!-- Avatar + nombre -->
            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 flex flex-col items-center text-center">
                @if (!string.IsNullOrEmpty(Model.FotoUrl) && Model.FotoUrl != "/img/default-user.png")
                {
                    <img src="@Model.FotoUrl" alt="Foto de perfil"
                         class="w-24 h-24 rounded-full object-cover border-4 border-gray-100 mb-4" />
                }
                else
                {
                    <div class="w-24 h-24 rounded-full bg-indigo-600 flex items-center justify-center mb-4 flex-shrink-0">
                        <span class="text-2xl font-bold text-white">@initials</span>
                    </div>
                }

                <p class="text-base font-bold text-gray-900 leading-tight">
                    @(string.IsNullOrWhiteSpace(Model.Nombre) ? "Sin nombre" : Model.Nombre)
                </p>
                <p class="text-xs text-gray-400 mt-1 break-all">@Model.Correo</p>
            </div>

            <!-- Estadísticas rápidas -->
            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 space-y-4">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-400">Resumen</p>

                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-500">Viajes realizados</span>
                    <span class="text-sm font-bold text-gray-900">@Model.HistorialViajes.Count</span>
                </div>

                <div class="h-px bg-gray-100"></div>

                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-500">Último destino</span>
                    <span class="text-sm font-semibold text-gray-700 text-right max-w-[120px] truncate">
                        @(Model.HistorialViajes.FirstOrDefault()?.Destino ?? "—")
                    </span>
                </div>
            </div>

        </aside>

        <!-- ── CONTENIDO ─────────────────────────────────────────── -->
        <div class="space-y-6">

            <!-- Información personal -->
            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 sm:p-8">
                <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-6">Información personal</h2>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                    <div class="bg-gray-50 rounded-2xl px-4 py-3.5">
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-0.5">Nombre</p>
                        <p class="text-sm font-semibold text-gray-800">
                            @(string.IsNullOrWhiteSpace(Model.Nombre) ? "—" : Model.Nombre)
                        </p>
                    </div>

                    <div class="bg-gray-50 rounded-2xl px-4 py-3.5">
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-0.5">Correo</p>
                        <p class="text-sm font-semibold text-gray-800 break-all">@Model.Correo</p>
                    </div>

                    <div class="bg-gray-50 rounded-2xl px-4 py-3.5">
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-0.5">Teléfono</p>
                        <p class="text-sm font-semibold text-gray-800">
                            @(string.IsNullOrWhiteSpace(Model.Telefono) ? "—" : Model.Telefono)
                        </p>
                    </div>

                    <div class="bg-gray-50 rounded-2xl px-4 py-3.5">
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-0.5">Documento</p>
                        <p class="text-sm font-semibold text-gray-800">
                            @(string.IsNullOrWhiteSpace(Model.Documento) ? "—" : Model.Documento)
                        </p>
                    </div>

                </div>
            </div>

            <!-- Historial de viajes -->
            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 sm:p-8">
                <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-6">Historial de viajes</h2>

                @if (!Model.HistorialViajes.Any())
                {
                    <div class="flex flex-col items-center justify-center py-10 text-center">
                        <div class="w-14 h-14 rounded-2xl bg-gray-50 flex items-center justify-center mb-4">
                            <svg class="w-7 h-7 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                            </svg>
                        </div>
                        <p class="text-sm font-semibold text-gray-500 mb-1">Sin viajes aún</p>
                        <p class="text-xs text-gray-400 mb-5">Cuando compres un boleto aparecerá aquí.</p>
                        <a href="/Rutas/Index"
                           class="inline-flex items-center gap-2 bg-gray-900 text-white px-5 py-2.5 rounded-2xl text-xs font-semibold hover:bg-indigo-600 transition-colors">
                            Ver rutas disponibles
                        </a>
                    </div>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var viaje in Model.HistorialViajes)
                        {
                            <div class="flex items-center justify-between p-4 rounded-2xl bg-gray-50 hover:bg-indigo-50 transition-colors group">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-xl bg-white border border-gray-100 flex items-center justify-center flex-shrink-0 group-hover:border-indigo-200 transition">
                                        <svg class="w-4 h-4 text-gray-400 group-hover:text-indigo-500 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-gray-800">
                                            @viaje.Origen
                                            <span class="text-gray-300 mx-1">→</span>
                                            @viaje.Destino
                                        </p>
                                        @if (viaje.Fecha != default)
                                        {
                                            <p class="text-[11px] text-gray-400 mt-0.5">@viaje.Fecha.ToString("ddd dd MMM yyyy · HH:mm")</p>
                                        }
                                    </div>
                                </div>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-semibold bg-green-50 text-green-700 flex-shrink-0">
                                    Completado
                                </span>
                            </div>
                        }
                    </div>
                    <a href="/Rutas/Index"
                       class="mt-5 flex items-center justify-center gap-2 w-full border border-gray-200 text-gray-500 py-3 rounded-2xl text-xs font-medium hover:bg-gray-50 transition-colors">
                        Ver más rutas
                    </a>
                }
            </div>

        </div>
    </div>

</main>

</body>
</html>
