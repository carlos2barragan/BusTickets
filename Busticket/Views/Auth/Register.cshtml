@model Busticket.Models.RegisterViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Busticket | Crear cuenta</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        * { font-family: 'Inter', sans-serif; }

        @@keyframes slideInFromRight {
            from { opacity: 0; transform: translateX(80px); }
            to   { opacity: 1; transform: translateX(0); }
        }
        @@keyframes slideOutToRight {
            from { opacity: 1; transform: translateX(0); }
            to   { opacity: 0; transform: translateX(80px); }
        }
        @@keyframes scaleIn {
            from { opacity: 0; transform: scale(1.06); }
            to   { opacity: 1; transform: scale(1); }
        }
        @@keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .card { animation: slideInFromRight 0.55s cubic-bezier(.25,.8,.25,1) both; }
        .card.exit { animation: slideOutToRight 0.4s cubic-bezier(.55,0,1,.45) forwards; }
        .anim-img-inner { animation: scaleIn 1s ease-out both; }
        .fade-section { animation: fadeSlideUp 0.3s ease-out both; }

        .input-field {
            width: 100%;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 0.75rem;
            padding: 0.72rem 1rem 0.72rem 2.75rem;
            font-size: 0.875rem;
            color: #1e293b;
            transition: all 0.2s;
        }
        .input-field::placeholder { color: #94a3b8; }
        .input-field:focus {
            outline: none;
            background: #fff;
            border-color: #6366f1;
            box-shadow: 0 0 0 4px rgba(99,102,241,0.08);
        }
        .btn-primary {
            display: block;
            width: 100%;
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            color: #fff;
            padding: 0.875rem;
            border-radius: 0.75rem;
            font-weight: 600;
            font-size: 0.875rem;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 8px 20px rgba(99,102,241,0.25);
        }
        .btn-primary:hover {
            box-shadow: 0 12px 28px rgba(99,102,241,0.4);
            transform: translateY(-2px);
        }
        .btn-primary:active { transform: translateY(0); }
    </style>
</head>
<body class="min-h-screen bg-slate-100 flex items-center justify-center p-4 py-8">

    <div id="card" class="card flex w-full max-w-5xl min-h-[680px] rounded-3xl overflow-hidden shadow-2xl shadow-slate-400/30">

        <!-- IMAGEN — IZQUIERDA -->
        <div class="w-1/2 overflow-hidden">
            <img src="https://res.cloudinary.com/dbt58u6ag/image/upload/v1764884373/chris-lee-70l1tDAI6rM-unsplash_2_b4fmff.png"
                 class="w-full h-full object-cover anim-img-inner hover:scale-105 transition-transform duration-[1400ms] ease-out"
                 alt="Imagen de ruta" />
        </div>

        <!-- FORM — DERECHA -->
        <div class="w-1/2 bg-white flex flex-col justify-center px-10 py-10 overflow-y-auto">
            <div class="max-w-sm w-full mx-auto">

                <div class="flex items-center gap-2 mb-6">
                    <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center">
                        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                        </svg>
                    </div>
                    <span class="font-bold text-slate-800 text-base tracking-tight">Busticket</span>
                </div>

                <h1 class="text-2xl font-bold text-slate-900 mb-1">Crear cuenta</h1>
                <p class="text-slate-500 text-sm mb-5">Completa los datos para empezar</p>

                <form asp-action="Register" method="post" class="space-y-3">

                    <!-- Tabs -->
                    <div class="flex p-1 bg-slate-100 rounded-xl mb-1">
                        <button type="button" data-tipo="Usuario"
                                class="tab-btn flex-1 py-2 rounded-lg text-sm font-semibold transition-all duration-200 bg-white text-slate-900 shadow-sm">
                            Cliente
                        </button>
                        <button type="button" data-tipo="Empresa"
                                class="tab-btn flex-1 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-slate-500">
                            Empresa
                        </button>
                    </div>

                    <input type="hidden" asp-for="TipoUsuario" id="TipoUsuario" value="Usuario" />

                    <!-- Campos Cliente -->
                    <div id="formUsuario" class="space-y-3">
                        <div class="space-y-1">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Nombre completo</label>
                            <div class="relative">
                                <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                                <input asp-for="Nombre" class="input-field" placeholder="Carlos Barragan" />
                            </div>
                            <span asp-validation-for="Nombre" class="text-red-500 text-xs"></span>
                        </div>
                    </div>

                    <!-- Campos Empresa -->
                    <div id="formEmpresa" class="space-y-3 hidden">
                        <div class="space-y-1">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Nombre de la empresa</label>
                            <div class="relative">
                                <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                </svg>
                                <input asp-for="NombreEmpresa" class="input-field" placeholder="Empresa S.A.S" />
                            </div>
                            <span asp-validation-for="NombreEmpresa" class="text-red-500 text-xs"></span>
                        </div>
                        <div class="space-y-1">
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider">NIT</label>
                            <div class="relative">
                                <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                </svg>
                                <input asp-for="Nit" id="Nit" class="input-field" placeholder="900123456-9" maxlength="11" />
                            </div>
                            <span asp-validation-for="Nit" class="text-red-500 text-xs"></span>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="space-y-1">
                        <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Correo electrónico</label>
                        <div class="relative">
                            <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                            <input asp-for="Email" type="email" class="input-field" placeholder="correo@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
                    </div>

                    <!-- Teléfono -->
                    <div class="space-y-1">
                        <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Teléfono</label>
                        <div class="relative">
                            <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                            </svg>
                            <input asp-for="Telefono" class="input-field" placeholder="3001234567" />
                        </div>
                        <span asp-validation-for="Telefono" class="text-red-500 text-xs"></span>
                    </div>

                    <!-- Contraseña -->
                    <div class="space-y-1">
                        <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Contraseña</label>
                        <div class="relative">
                            <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                            <input asp-for="Password" id="passwordInput" type="password" class="input-field pr-11" placeholder="••••••••" />
                            <button type="button" onclick="togglePass('passwordInput')"
                                    class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 transition-colors">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
                    </div>

                    <!-- Confirmar -->
                    <div class="space-y-1">
                        <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Confirmar contraseña</label>
                        <div class="relative">
                            <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                            <input asp-for="ConfirmPassword" id="confirmPasswordInput" type="password" class="input-field pr-11" placeholder="••••••••" />
                            <button type="button" onclick="togglePass('confirmPasswordInput')"
                                    class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 transition-colors">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs"></span>
                    </div>

                    <button type="submit" class="btn-primary">Crear cuenta</button>

                    <p class="text-center text-slate-500 text-sm">
                        ¿Ya tienes cuenta?
                        <a href="/Auth/Login" class="text-indigo-600 font-semibold hover:text-indigo-700 transition-colors">Inicia sesión</a>
                    </p>

                </form>
            </div>
        </div>

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        const tabs = document.querySelectorAll('.tab-btn');
        const tipoInput = document.getElementById('TipoUsuario');
        const formUsuario = document.getElementById('formUsuario');
        const formEmpresa = document.getElementById('formEmpresa');

        tabs.forEach(btn => {
            btn.addEventListener('click', () => {
                const tipo = btn.dataset.tipo;
                tipoInput.value = tipo;

                tabs.forEach(b => {
                    b.classList.remove('bg-white', 'text-slate-900', 'shadow-sm');
                    b.classList.add('text-slate-500');
                });
                btn.classList.add('bg-white', 'text-slate-900', 'shadow-sm');
                btn.classList.remove('text-slate-500');

                if (tipo === 'Empresa') {
                    formEmpresa.classList.remove('hidden');
                    formEmpresa.classList.add('fade-section');
                    formUsuario.classList.add('hidden');
                } else {
                    formUsuario.classList.remove('hidden');
                    formUsuario.classList.add('fade-section');
                    formEmpresa.classList.add('hidden');
                }
            });
        });

        const nitInput = document.getElementById('Nit');
        if (nitInput) {
            nitInput.addEventListener('input', () => {
                let val = nitInput.value.replace(/[^0-9]/g, '').substring(0, 9);
                nitInput.value = val.length > 0 ? val + '-9' : '';
            });
        }

        function togglePass(id) {
            const input = document.getElementById(id);
            input.type = input.type === 'password' ? 'text' : 'password';
        }

        // Transición de salida hacia la derecha al ir a Login
        document.querySelector('a[href="/Auth/Login"]').addEventListener('click', function(e) {
            e.preventDefault();
            const dest = this.href;
            const card = document.getElementById('card');
            card.classList.add('exit');
            setTimeout(() => { window.location.href = dest; }, 380);
        });

        $.validator.setDefaults({ ignore: ':hidden' });
    </script>
</body>
</html>
