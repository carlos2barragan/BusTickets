<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
    body { font-family: 'Inter', sans-serif; }
    #header { transition: all .3s; }
    .header-scrolled {
        background: rgba(255,255,255,0.97) !important;
        backdrop-filter: blur(20px);
        box-shadow: 0 1px 0 rgba(0,0,0,.07);
    }
    .profile-dropdown { display: none; }
    .profile-dropdown.open { display: block; }
</style>

<!-- ═══ HEADER ═══════════════════════════════════════════════════ -->
<header id="header"
        class="fixed top-0 inset-x-0 z-50 bg-white/85 backdrop-blur-md border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-10 py-5 flex items-center justify-between">

        <!-- Izquierda -->
        <div class="flex items-center gap-5">
            <button onclick="history.back()"
                    class="flex items-center gap-1.5 text-xs tracking-widest uppercase text-gray-500
                           hover:text-gray-900 transition-colors group">
                <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform duration-200"
                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                </svg>
                Volver
            </button>
            <div class="w-px h-4 bg-gray-200"></div>
            <a href="/Home/Index" class="text-xl tracking-widest uppercase font-semibold text-gray-900">
                Busticket
            </a>
        </div>

        <!-- Derecha -->
        <nav class="hidden md:flex gap-8 text-xs tracking-widest uppercase items-center text-gray-700">
            <a href="/Ayuda"
               class="relative after:absolute after:left-0 after:-bottom-1 after:w-0 after:h-px
                      after:bg-gray-900 after:transition-all after:duration-300 hover:after:w-full hover:text-gray-900 transition-colors">
                Ayuda
            </a>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="relative" id="profileWrapper">
                    <button onclick="toggleSharedDropdown()"
                            class="flex items-center justify-center w-9 h-9 rounded-full border border-gray-300
                                   hover:bg-gray-900 hover:text-white hover:border-gray-900 transition-all duration-200">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </button>
                    <div id="profileDropdown"
                         class="profile-dropdown absolute right-0 mt-3 w-48 bg-white border border-gray-100
                                rounded-2xl overflow-hidden shadow-xl shadow-gray-200/60">
                        <a href="/Perfil"
                           class="flex items-center gap-3 px-5 py-3.5 text-sm text-gray-700 hover:bg-gray-50
                                  transition-colors normal-case tracking-normal font-normal">
                            <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            Mi perfil
                        </a>
                        <div class="h-px bg-gray-100"></div>
                        <form asp-controller="Auth" asp-action="Logout" method="post">
                            <button type="submit"
                                    class="w-full flex items-center gap-3 px-5 py-3.5 text-sm text-red-500
                                           hover:bg-red-50 transition-colors normal-case tracking-normal font-normal">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                                </svg>
                                Cerrar sesión
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <a href="/Auth/Login"
                   class="relative after:absolute after:left-0 after:-bottom-1 after:w-0 after:h-px
                          after:bg-gray-900 after:transition-all after:duration-300 hover:after:w-full hover:text-gray-900 transition-colors">
                    Iniciar sesión
                </a>
            }

            @if (User.IsInRole("Admin"))
            {
                <a href="/Admin/Index"
                   class="relative after:absolute after:left-0 after:-bottom-1 after:w-0 after:h-px
                          after:bg-gray-900 after:transition-all after:duration-300 hover:after:w-full hover:text-gray-900 transition-colors">
                    Admin
                </a>
            }
            @if (User.IsInRole("Empresa"))
            {
                <a href="/PanelEmpresa/Index"
                   class="relative after:absolute after:left-0 after:-bottom-1 after:w-0 after:h-px
                          after:bg-gray-900 after:transition-all after:duration-300 hover:after:w-full hover:text-gray-900 transition-colors">
                    Empresa
                </a>
            }
        </nav>

        <button id="sharedMenuBtn" class="md:hidden text-xl text-gray-700 z-50">☰</button>
    </div>
</header>

<!-- Menú móvil -->
<div id="sharedMobileMenu"
     class="fixed inset-0 bg-black/90 backdrop-blur-sm flex flex-col items-center justify-center
            space-y-8 uppercase tracking-widest text-lg transform -translate-y-full
            transition-transform duration-500 md:hidden z-40 text-white">
    <a href="/Ayuda">Ayuda</a>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a href="/Perfil">Mi perfil</a>
        <form asp-controller="Auth" asp-action="Logout" method="post">
            <button type="submit">Cerrar sesión</button>
        </form>
    }
    else { <a href="/Auth/Login">Iniciar sesión</a> }
    @if (User.IsInRole("Admin")) { <a href="/Admin/Index">Admin</a> }
    @if (User.IsInRole("Empresa")) { <a href="/PanelEmpresa/Index">Empresa</a> }
</div>

<script>
    function toggleSharedDropdown() {
        document.getElementById('profileDropdown')?.classList.toggle('open');
    }
    document.addEventListener('click', function(e) {
        var w = document.getElementById('profileWrapper');
        if (w && !w.contains(e.target))
            document.getElementById('profileDropdown')?.classList.remove('open');
    });
    window.addEventListener('scroll', function() {
        document.getElementById('header')
            .classList.toggle('header-scrolled', window.scrollY > 10);
    });
    (function() {
        var btn  = document.getElementById('sharedMenuBtn');
        var menu = document.getElementById('sharedMobileMenu');
        if (!btn) return;
        var open = false;
        btn.addEventListener('click', function() {
            open = !open;
            menu.classList.toggle('-translate-y-full', !open);
            btn.textContent = open ? '✕' : '☰';
        });
    })();
</script>
