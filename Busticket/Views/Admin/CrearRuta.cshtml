@model Busticket.Models.Ruta
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Busticket | Nueva Ruta</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        input[type=radio]:checked + .tipo-card {
            --tw-ring-color: #6366f1;
            --tw-ring-shadow: 0 0 0 2px var(--tw-ring-color);
            box-shadow: var(--tw-ring-shadow);
            background-color: #eef2ff;
            border-color: #6366f1;
        }
    </style>
</head>
<body class="bg-[#f7f8fa] text-gray-800">
<partial name="_SharedHeader" />
<main class="max-w-screen-lg mx-auto px-4 sm:px-6 lg:px-10 pt-28 pb-16">

    <div class="max-w-2xl mx-auto">
        <a asp-controller="Admin" asp-action="Rutas"
           class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            Volver a Rutas
        </a>

        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-1">Admin / Rutas</p>
            <h1 class="text-2xl font-bold text-gray-900 mb-8">Nueva ruta</h1>

            <form asp-controller="Admin" asp-action="CrearRuta" method="post" class="space-y-7">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-red-500 text-xs mb-2"></div>

                <!-- ── TIPO DE BUS ──────────────────────────────── -->
                <div>
                    <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-3">Tipo de bus</label>
                    <div class="grid grid-cols-3 gap-3">

                        <label class="cursor-pointer">
                            <input type="radio" name="TipoBus" value="Normal" class="sr-only" checked
                                   onchange="onTipoBusChange('Normal')">
                            <div class="tipo-card border-2 border-indigo-500 bg-indigo-50 rounded-2xl p-4 text-center transition select-none" id="card-Normal">
                                <div class="text-3xl mb-2">🚌</div>
                                <p class="text-sm font-bold text-gray-800">Normal</p>
                                <p class="text-[11px] text-gray-400 mt-0.5">Un piso · 4 filas</p>
                            </div>
                        </label>

                        <label class="cursor-pointer">
                            <input type="radio" name="TipoBus" value="DosPisos" class="sr-only"
                                   onchange="onTipoBusChange('DosPisos')">
                            <div class="tipo-card border-2 border-gray-200 bg-white rounded-2xl p-4 text-center transition select-none" id="card-DosPisos">
                                <div class="text-3xl mb-2">🏢</div>
                                <p class="text-sm font-bold text-gray-800">Dos pisos</p>
                                <p class="text-[11px] text-gray-400 mt-0.5">Doble piso · 8 filas</p>
                            </div>
                        </label>

                        <label class="cursor-pointer">
                            <input type="radio" name="TipoBus" value="VIP" class="sr-only"
                                   onchange="onTipoBusChange('VIP')">
                            <div class="tipo-card border-2 border-gray-200 bg-white rounded-2xl p-4 text-center transition select-none" id="card-VIP">
                                <div class="text-3xl mb-2">⭐</div>
                                <p class="text-sm font-bold text-gray-800">VIP</p>
                                <p class="text-[11px] text-gray-400 mt-0.5">Un piso · 3 filas</p>
                            </div>
                        </label>

                    </div>
                </div>

                <!-- ── NÚMERO DE ASIENTOS ────────────────────────── -->
                <div>
                    <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-3">Número de asientos</label>

                    <!-- Presets Normal -->
                    <div id="presets-Normal" class="flex flex-wrap gap-2 mb-3">
                        <span class="text-xs text-gray-400 self-center mr-1">Sugeridos:</span>
                        @foreach (var n in new[]{20,30,40,44})
                        {
                            <button type="button" onclick="setAsientos(@n)"
                                    class="preset-btn px-3 py-1.5 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 hover:border-indigo-400 hover:text-indigo-600 transition">
                                @n
                            </button>
                        }
                    </div>

                    <!-- Presets DosPisos -->
                    <div id="presets-DosPisos" class="flex flex-wrap gap-2 mb-3 hidden">
                        <span class="text-xs text-gray-400 self-center mr-1">Sugeridos:</span>
                        @foreach (var n in new[]{40,56,64,80})
                        {
                            <button type="button" onclick="setAsientos(@n)"
                                    class="preset-btn px-3 py-1.5 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 hover:border-indigo-400 hover:text-indigo-600 transition">
                                @n
                            </button>
                        }
                    </div>

                    <!-- Presets VIP -->
                    <div id="presets-VIP" class="flex flex-wrap gap-2 mb-3 hidden">
                        <span class="text-xs text-gray-400 self-center mr-1">Sugeridos:</span>
                        @foreach (var n in new[]{15,21,27,33})
                        {
                            <button type="button" onclick="setAsientos(@n)"
                                    class="preset-btn px-3 py-1.5 rounded-xl border border-gray-200 text-xs font-semibold text-gray-600 hover:border-indigo-400 hover:text-indigo-600 transition">
                                @n
                            </button>
                        }
                    </div>

                    <input asp-for="NumAsientos" id="NumAsientos" type="number" min="4" max="120" value="20"
                           class="w-full border border-gray-200 rounded-2xl px-4 py-3 text-sm text-gray-800 bg-gray-50
                                  focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition" />
                    <span asp-validation-for="NumAsientos" class="text-red-500 text-xs mt-1"></span>
                    <p id="asientosHint" class="text-[11px] text-gray-400 mt-1.5">Bus de un piso: 4 columnas (ventana · pasillo | pasillo · ventana)</p>
                </div>

                <hr class="border-gray-100" />

                <!-- ── RUTA ─────────────────────────────────────── -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-1.5">Ciudad Origen</label>
                        <select asp-for="CiudadOrigenId"
                                class="w-full border border-gray-200 rounded-2xl px-4 py-3 text-sm text-gray-800 bg-gray-50 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition"
                                asp-items="@(new SelectList(ViewBag.Ciudades, "CiudadId", "Nombre"))">
                            <option value="">-- Origen --</option>
                        </select>
                        <span asp-validation-for="CiudadOrigenId" class="text-red-500 text-xs mt-1"></span>
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-1.5">Ciudad Destino</label>
                        <select asp-for="CiudadDestinoId"
                                class="w-full border border-gray-200 rounded-2xl px-4 py-3 text-sm text-gray-800 bg-gray-50 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition"
                                asp-items="@(new SelectList(ViewBag.Ciudades, "CiudadId", "Nombre"))">
                            <option value="">-- Destino --</option>
                        </select>
                        <span asp-validation-for="CiudadDestinoId" class="text-red-500 text-xs mt-1"></span>
                    </div>
                </div>

                <div>
                    <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-1.5">Empresa</label>
                    <select asp-for="EmpresaId"
                            class="w-full border border-gray-200 rounded-2xl px-4 py-3 text-sm text-gray-800 bg-gray-50 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition"
                            asp-items="@(new SelectList(ViewBag.Empresas, "EmpresaId", "Nombre"))">
                        <option value="">-- Seleccione Empresa --</option>
                    </select>
                    <span asp-validation-for="EmpresaId" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <!-- Precio -->
                    <div>
                        <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-1.5">Precio (COP)</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-sm text-gray-400 font-medium pointer-events-none">$</span>
                            <input type="text" id="PrecioDisplay" inputmode="numeric" placeholder="0"
                                   class="w-full border border-gray-200 rounded-2xl pl-8 pr-4 py-3 text-sm text-gray-800 bg-gray-50 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition" />
                        </div>
                        <input type="hidden" asp-for="Precio" id="PrecioHidden" />
                        <span asp-validation-for="Precio" class="text-red-500 text-xs mt-1"></span>
                    </div>
                    <!-- Duración -->
                    <div>
                        <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-1.5">Duración</label>
                        <div class="grid grid-cols-2 gap-2">
                            <div class="relative">
                                <input type="number" id="DurHoras" min="0" max="99" placeholder="0"
                                       class="w-full border border-gray-200 rounded-2xl px-4 pr-10 py-3 text-sm text-gray-800 bg-gray-50 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition" />
                                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-gray-400 pointer-events-none">h</span>
                            </div>
                            <select id="DurMinutos"
                                    class="w-full border border-gray-200 rounded-2xl px-3 py-3 text-sm text-gray-800 bg-gray-50 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition">
                                <option value="0">00 min</option>
                                <option value="15">15 min</option>
                                <option value="30">30 min</option>
                                <option value="45">45 min</option>
                            </select>
                        </div>
                        <input type="hidden" asp-for="DuracionMin" id="DuracionMinHidden" />
                        <span asp-validation-for="DuracionMin" class="text-red-500 text-xs mt-1"></span>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-1.5">Fecha de Salida</label>
                        <input asp-for="FechaSalida" type="datetime-local"
                               class="w-full border border-gray-200 rounded-2xl px-4 py-3 text-sm text-gray-800 bg-gray-50 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition" />
                        <span asp-validation-for="FechaSalida" class="text-red-500 text-xs mt-1"></span>
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-1.5">Fecha de Llegada</label>
                        <input asp-for="FechaLlegada" type="datetime-local"
                               class="w-full border border-gray-200 rounded-2xl px-4 py-3 text-sm text-gray-800 bg-gray-50 focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 transition" />
                        <span asp-validation-for="FechaLlegada" class="text-red-500 text-xs mt-1"></span>
                    </div>
                </div>

                <div class="pt-2 space-y-3">
                    <button type="submit"
                            class="w-full bg-gray-900 text-white py-3 rounded-2xl text-sm font-semibold hover:bg-indigo-600 transition-colors duration-200">
                        Crear Ruta
                    </button>
                    <a asp-controller="Admin" asp-action="Rutas"
                       class="flex items-center justify-center w-full border border-gray-200 text-gray-600 py-3 rounded-2xl text-sm font-medium hover:bg-gray-50 transition-colors">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>

</main>

<script>
    var currentTipo = 'Normal';

    const hints = {
        Normal:   'Bus de un piso · 4 columnas (ventana · pasillo | pasillo · ventana)',
        DosPisos: 'Bus de dos pisos · 8 columnas totales, 4 por piso',
        VIP:      'Bus VIP · 3 columnas (ventana | pasillo · ventana)',
    };

    function onTipoBusChange(tipo) {
        // Reset all cards
        ['Normal','DosPisos','VIP'].forEach(t => {
            const card = document.getElementById('card-' + t);
            card.classList.remove('border-indigo-500','bg-indigo-50');
            card.classList.add('border-gray-200','bg-white');
            document.getElementById('presets-' + t).classList.add('hidden');
        });
        // Activate selected
        const active = document.getElementById('card-' + tipo);
        active.classList.remove('border-gray-200','bg-white');
        active.classList.add('border-indigo-500','bg-indigo-50');
        document.getElementById('presets-' + tipo).classList.remove('hidden');
        document.getElementById('asientosHint').textContent = hints[tipo];
        currentTipo = tipo;

        // Set default seat count
        const defaults = { Normal: 20, DosPisos: 40, VIP: 21 };
        document.getElementById('NumAsientos').value = defaults[tipo];
    }

    function setAsientos(n) {
        document.getElementById('NumAsientos').value = n;
    }

    function formatPrecio(input) {
        const digits = input.value.replace(/\D/g, '');
        const num    = parseInt(digits || '0', 10);
        input.value  = num > 0 ? num.toLocaleString('en-US') : '';
        document.getElementById('PrecioHidden').value = digits || '0';
    }

    function updateDuracion() {
        const h = parseInt(document.getElementById('DurHoras').value   || '0', 10);
        const m = parseInt(document.getElementById('DurMinutos').value || '0', 10);
        document.getElementById('DuracionMinHidden').value = h * 60 + m;
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Init price display from model (POST-back)
        const ph = document.getElementById('PrecioHidden');
        const pd = document.getElementById('PrecioDisplay');
        const pv = parseInt(ph.value || '0', 10);
        if (pv > 0) pd.value = pv.toLocaleString('en-US');
        pd.addEventListener('input', function () { formatPrecio(this); });

        // Init duration display from model (POST-back)
        const dh = document.getElementById('DuracionMinHidden');
        const dv = parseInt(dh.value || '0', 10);
        if (dv > 0) {
            document.getElementById('DurHoras').value = Math.floor(dv / 60);
            const rem = dv % 60;
            document.getElementById('DurMinutos').value = [0,15,30,45].reduce((p,c) => Math.abs(c-rem)<Math.abs(p-rem)?c:p).toString();
        }
        document.getElementById('DurHoras').addEventListener('input',    updateDuracion);
        document.getElementById('DurMinutos').addEventListener('change', updateDuracion);
        updateDuracion();

        const success = '@TempData["SuccessMessage"]';
        const error   = '@TempData["ErrorMessage"]';
        if (success && success.trim()) Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: success, showConfirmButton: false, timer: 2500 });
        if (error   && error.trim())   Swal.fire({ toast: true, position: 'top-end', icon: 'error',   title: error,   showConfirmButton: false, timer: 3000 });
    });
</script>
</body>
</html>
