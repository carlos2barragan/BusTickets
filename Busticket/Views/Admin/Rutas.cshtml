@model List<Busticket.Models.Ruta>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Busticket | Rutas</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-[#f7f8fa] text-gray-800">
<partial name="_SharedHeader" />
<main class="max-w-screen-lg mx-auto px-4 sm:px-6 lg:px-10 pt-28 pb-16">

    <!-- Header row -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-1">Admin</p>
            <h1 class="text-2xl font-bold text-gray-900">Rutas</h1>
        </div>
        <a asp-controller="Admin" asp-action="CrearRuta"
           class="inline-flex items-center gap-2 bg-gray-900 text-white px-5 py-2.5 rounded-2xl text-sm font-semibold hover:bg-indigo-600 transition-colors duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            Nueva ruta
        </a>
    </div>

    <!-- Table card -->
    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr>
                        <th class="text-xs uppercase tracking-widest text-gray-400 font-semibold px-6 py-4 text-left bg-gray-50 border-b border-gray-100">Origen</th>
                        <th class="text-xs uppercase tracking-widest text-gray-400 font-semibold px-6 py-4 text-left bg-gray-50 border-b border-gray-100">Destino</th>
                        <th class="text-xs uppercase tracking-widest text-gray-400 font-semibold px-6 py-4 text-left bg-gray-50 border-b border-gray-100">Empresa</th>
                        <th class="text-xs uppercase tracking-widest text-gray-400 font-semibold px-6 py-4 text-left bg-gray-50 border-b border-gray-100">Precio</th>
                        <th class="text-xs uppercase tracking-widest text-gray-400 font-semibold px-6 py-4 text-left bg-gray-50 border-b border-gray-100">Salida</th>
                        <th class="text-xs uppercase tracking-widest text-gray-400 font-semibold px-6 py-4 text-left bg-gray-50 border-b border-gray-100">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 transition-colors border-b border-gray-100">
                            <td class="px-6 py-4 text-sm text-gray-700 font-medium">@item.CiudadOrigen?.Nombre</td>
                            <td class="px-6 py-4 text-sm text-gray-700">@item.CiudadDestino?.Nombre</td>
                            <td class="px-6 py-4 text-sm text-gray-700">@item.Empresa?.Nombre</td>
                            <td class="px-6 py-4 text-sm text-gray-700">$@item.Precio.ToString("N0") COP</td>
                            <td class="px-6 py-4 text-sm text-gray-700">@item.FechaSalida.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-1">
                                    <a asp-controller="Admin" asp-action="EditarRuta" asp-route-id="@item.RutaId"
                                       class="text-gray-400 hover:text-indigo-600 transition-colors p-1" title="Editar">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 012.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-2a2 2 0 01.586-1.414z" />
                                        </svg>
                                    </a>
                                    <a asp-controller="Admin" asp-action="EliminarRuta" asp-route-id="@item.RutaId"
                                       class="text-gray-400 hover:text-red-500 transition-colors p-1" title="Eliminar">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3M4 7h16" />
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</main>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const success = '@TempData["SuccessMessage"]';
        const error   = '@TempData["ErrorMessage"]';
        if (success && success.trim()) Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: success, showConfirmButton: false, timer: 2500 });
        if (error   && error.trim())   Swal.fire({ toast: true, position: 'top-end', icon: 'error',   title: error,   showConfirmButton: false, timer: 3000 });
    });
</script>
</body>
</html>
