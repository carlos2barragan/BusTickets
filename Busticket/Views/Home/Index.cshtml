@{
    ViewBag.Title = "Busticket - Home";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Busticket</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }

        /* Reveal on scroll */
        .reveal {
            opacity: 0;
            transform: translateY(36px);
            transition: opacity 0.75s ease, transform 0.75s ease;
        }
        .reveal.active { opacity: 1; transform: translateY(0); }
        .reveal-delay-1 { transition-delay: 0.1s; }
        .reveal-delay-2 { transition-delay: 0.2s; }
        .reveal-delay-3 { transition-delay: 0.3s; }

        /* Header blur on scroll */
        .header-scrolled { background: rgba(0,0,0,0.75); backdrop-filter: blur(16px); }

        /* Step number gradient */
        .step-num {
            background: linear-gradient(135deg, #6366f1, #a855f7);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Card hover */
        .benefit-card {
            transition: transform 0.25s ease, background 0.25s ease;
        }
        .benefit-card:hover { transform: translateY(-4px); background: rgba(255,255,255,0.07); }

        /* Dropdown perfil */
        .profile-dropdown { display: none; }
        .profile-dropdown.open { display: block; }
    </style>
</head>

<body class="bg-black text-white antialiased">

    <!-- HEADER -->
    <header id="header" class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-10 py-7 flex items-center justify-between">

            <a class="text-2xl tracking-widest uppercase font-semibold">Busticket</a>

            <button id="menuBtn" class="md:hidden text-2xl z-50 relative">☰</button>

            <nav class="hidden md:flex gap-10 text-xs tracking-widest uppercase items-center">
                <a href="/Ayuda"
                   class="relative after:absolute after:left-0 after:-bottom-1 after:w-0 after:h-px
                          after:bg-white after:transition-all after:duration-300 hover:after:w-full">
                    Ayuda
                </a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <!-- Dropdown perfil -->
                    <div class="relative" id="profileWrapper">
                        <button onclick="toggleDropdown()"
                                class="flex items-center justify-center w-10 h-10 rounded-full border border-white/40
                                       hover:bg-white hover:text-black transition-all duration-200">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                        </button>

                        <div id="profileDropdown"
                             class="profile-dropdown absolute right-0 mt-3 w-48 bg-white/10 backdrop-blur-xl
                                    border border-white/15 rounded-2xl overflow-hidden shadow-2xl">
                            <a href="/Perfil"
                               class="flex items-center gap-3 px-5 py-3.5 text-sm text-white/80 hover:bg-white/10 hover:text-white transition-colors normal-case tracking-normal font-normal">
                                <svg class="w-4 h-4 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                                Mi perfil
                            </a>
                            <div class="h-px bg-white/10"></div>
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                <button type="submit"
                                        class="w-full flex items-center gap-3 px-5 py-3.5 text-sm text-red-400 hover:bg-white/10 hover:text-red-300 transition-colors normal-case tracking-normal font-normal">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                                    </svg>
                                    Cerrar sesión
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/Auth/Login"
                       class="relative after:absolute after:left-0 after:-bottom-1 after:w-0 after:h-px
                              after:bg-white after:transition-all after:duration-300 hover:after:w-full">
                        Iniciar sesión
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <a href="/Admin/Index"
                       class="relative after:absolute after:left-0 after:-bottom-1 after:w-0 after:h-px
                              after:bg-white after:transition-all after:duration-300 hover:after:w-full">
                        Admin
                    </a>
                }
                @if (User.IsInRole("Empresa"))
                {
                    <a href="/PanelEmpresa/Index"
                       class="relative after:absolute after:left-0 after:-bottom-1 after:w-0 after:h-px
                              after:bg-white after:transition-all after:duration-300 hover:after:w-full">
                        Empresa
                    </a>
                }
            </nav>
        </div>
    </header>

    <!-- MENÚ MÓVIL -->
    <div id="mobileMenu"
         class="fixed inset-0 bg-black/90 backdrop-blur-sm flex flex-col items-center justify-center
                space-y-8 uppercase tracking-widest text-lg transform -translate-y-full
                transition-transform duration-500 md:hidden z-40">
        <a href="/Ayuda">Ayuda</a>
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a href="/Perfil">Perfil</a>
            <form asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit">Cerrar sesión</button>
            </form>
        }
        else
        {
            <a href="/Auth/Login">Iniciar sesión</a>
        }
        @if (User.IsInRole("Admin")) { <a href="/Admin/Index">Admin</a> }
        @if (User.IsInRole("Empresa")) { <a href="/PanelEmpresa/Index">Empresa</a> }
    </div>

    <!-- ═══════════════════════════════ HERO ═══════════════════════════════ -->
    <section class="relative h-screen w-full overflow-hidden">
        <img src="https://res.cloudinary.com/dbt58u6ag/image/upload/f_auto,q_auto,w_1920/imagen_fondo_d86xtq.jpg"
             class="absolute inset-0 w-full h-full object-cover scale-105 transition-transform duration-[8s] ease-out"
             id="heroImg" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>

        <div class="relative z-10 flex items-center justify-center h-full text-center">
            <div class="max-w-3xl mx-auto px-8">

                <!-- Badge centrado -->
                <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20
                            text-white/80 text-xs uppercase tracking-widest px-4 py-2 rounded-full mb-8">
                    <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
                    Plataforma de tiquetes de bus
                </div>

                <h1 class="text-5xl md:text-7xl font-semibold leading-[1.1] mb-6">
                    La nueva forma<br/>
                    <span class="text-white/60">de viajar en bus</span>
                </h1>

                <p class="text-white/60 text-lg mb-10 max-w-md mx-auto leading-relaxed">
                    Busca rutas, compara precios y compra tu tiquete en minutos, desde cualquier dispositivo.
                </p>

                <div class="flex flex-wrap items-center justify-center gap-4">
                    <a href="/Rutas/Index"
                       class="bg-white text-black px-8 py-3.5 rounded-full text-sm font-semibold
                              hover:bg-white/90 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-white/20">
                        Buscar rutas
                    </a>
                    <a href="#como-funciona"
                       class="flex items-center gap-2 text-white/70 text-sm hover:text-white transition-colors">
                        <span>Cómo funciona</span>
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </a>
                </div>

                <!-- Stats centrados -->
                <div class="flex flex-wrap justify-center gap-10 mt-16">
                    <div>
                        <p class="text-3xl font-bold">50<span class="text-indigo-400">+</span></p>
                        <p class="text-white/50 text-xs uppercase tracking-wider mt-1">Rutas activas</p>
                    </div>
                    <div class="w-px bg-white/10"></div>
                    <div>
                        <p class="text-3xl font-bold">98<span class="text-indigo-400">%</span></p>
                        <p class="text-white/50 text-xs uppercase tracking-wider mt-1">Satisfacción</p>
                    </div>
                    <div class="w-px bg-white/10"></div>
                    <div>
                        <p class="text-3xl font-bold">24<span class="text-indigo-400">/7</span></p>
                        <p class="text-white/50 text-xs uppercase tracking-wider mt-1">Disponible</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Scroll indicator -->
        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/30">
            <span class="text-xs uppercase tracking-widest">Scroll</span>
            <div class="w-px h-10 bg-gradient-to-b from-white/30 to-transparent"></div>
        </div>
    </section>

    <!-- ═══════════════════════════════ QUÉ ES ═══════════════════════════════ -->
    <section class="py-28 reveal">
        <div class="max-w-7xl mx-auto px-8">
            <div class="grid md:grid-cols-2 gap-16 items-center">
                <div>
                    <p class="text-indigo-400 text-xs uppercase tracking-widest mb-4 font-semibold">Sobre Busticket</p>
                    <h2 class="text-4xl md:text-5xl font-semibold leading-tight mb-6">
                        Viajar en bus<br/>nunca fue tan fácil
                    </h2>
                    <p class="text-white/60 leading-relaxed">
                        Busticket centraliza todas las rutas de bus del país en una sola plataforma.
                        Busca, compara y compra tu boleto sin filas, sin llamadas y sin complicaciones.
                    </p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-white/5 border border-white/10 rounded-2xl p-6 reveal reveal-delay-1">
                        <p class="text-4xl font-bold mb-2">50<span class="text-indigo-400">+</span></p>
                        <p class="text-white/50 text-sm">Rutas disponibles</p>
                    </div>
                    <div class="bg-white/5 border border-white/10 rounded-2xl p-6 reveal reveal-delay-2">
                        <p class="text-4xl font-bold mb-2">5<span class="text-indigo-400">min</span></p>
                        <p class="text-white/50 text-sm">Para comprar tu tiquete</p>
                    </div>
                    <div class="bg-white/5 border border-white/10 rounded-2xl p-6 reveal reveal-delay-2 col-span-2">
                        <p class="text-4xl font-bold mb-2">100<span class="text-indigo-400">%</span></p>
                        <p class="text-white/50 text-sm">En línea — sin ir a la terminal</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════ CÓMO FUNCIONA ═══════════════════════════════ -->
    <section id="como-funciona" class="bg-neutral-950 py-28">
        <div class="max-w-7xl mx-auto px-8">
            <div class="text-center mb-20 reveal">
                <p class="text-indigo-400 text-xs uppercase tracking-widest mb-4 font-semibold">Proceso</p>
                <h2 class="text-4xl md:text-5xl font-semibold">¿Cómo funciona?</h2>
            </div>

            <div class="grid md:grid-cols-3 gap-px bg-white/5 rounded-3xl overflow-hidden">

                <div class="bg-neutral-950 p-10 reveal reveal-delay-1 group">
                    <p class="step-num text-6xl font-bold mb-6">01</p>
                    <h3 class="text-xl font-semibold mb-3">Busca tu ruta</h3>
                    <p class="text-white/50 leading-relaxed text-sm">
                        Ingresa tu ciudad de origen, destino y la fecha de viaje para ver todas las opciones disponibles.
                    </p>
                    <div class="mt-6 w-8 h-px bg-indigo-500 group-hover:w-16 transition-all duration-300"></div>
                </div>

                <div class="bg-neutral-950 p-10 reveal reveal-delay-2 group border-l border-r border-white/5">
                    <p class="step-num text-6xl font-bold mb-6">02</p>
                    <h3 class="text-xl font-semibold mb-3">Compara opciones</h3>
                    <p class="text-white/50 leading-relaxed text-sm">
                        Filtra por horario, precio o empresa de transporte y elige la que mejor se adapte a ti.
                    </p>
                    <div class="mt-6 w-8 h-px bg-indigo-500 group-hover:w-16 transition-all duration-300"></div>
                </div>

                <div class="bg-neutral-950 p-10 reveal reveal-delay-3 group">
                    <p class="step-num text-6xl font-bold mb-6">03</p>
                    <h3 class="text-xl font-semibold mb-3">Compra y viaja</h3>
                    <p class="text-white/50 leading-relaxed text-sm">
                        Pago 100% seguro y tu boleto digital disponible de inmediato. Sin colas, sin esperas.
                    </p>
                    <div class="mt-6 w-8 h-px bg-indigo-500 group-hover:w-16 transition-all duration-300"></div>
                </div>

            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════ BENEFICIOS ═══════════════════════════════ -->
    <section class="py-28">
        <div class="max-w-7xl mx-auto px-8">
            <div class="text-center mb-20 reveal">
                <p class="text-indigo-400 text-xs uppercase tracking-widest mb-4 font-semibold">Ventajas</p>
                <h2 class="text-4xl md:text-5xl font-semibold">¿Por qué Busticket?</h2>
            </div>

            <div class="grid md:grid-cols-3 gap-4">

                <div class="benefit-card bg-white/[0.03] border border-white/10 rounded-2xl p-8 reveal reveal-delay-1">
                    <div class="w-10 h-10 bg-indigo-500/15 rounded-xl flex items-center justify-center mb-5">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                    </div>
                    <h3 class="font-semibold mb-2">Compra 100% en línea</h3>
                    <p class="text-white/50 text-sm leading-relaxed">Sin ir a la terminal, sin filas, desde donde estés.</p>
                </div>

                <div class="benefit-card bg-white/[0.03] border border-white/10 rounded-2xl p-8 reveal reveal-delay-2">
                    <div class="w-10 h-10 bg-indigo-500/15 rounded-xl flex items-center justify-center mb-5">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                        </svg>
                    </div>
                    <h3 class="font-semibold mb-2">Varias empresas</h3>
                    <p class="text-white/50 text-sm leading-relaxed">Compara entre múltiples empresas de transporte en un solo lugar.</p>
                </div>

                <div class="benefit-card bg-white/[0.03] border border-white/10 rounded-2xl p-8 reveal reveal-delay-3">
                    <div class="w-10 h-10 bg-indigo-500/15 rounded-xl flex items-center justify-center mb-5">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                    </div>
                    <h3 class="font-semibold mb-2">Pago seguro</h3>
                    <p class="text-white/50 text-sm leading-relaxed">Transacciones protegidas con los más altos estándares de seguridad.</p>
                </div>

                <div class="benefit-card bg-white/[0.03] border border-white/10 rounded-2xl p-8 reveal reveal-delay-1">
                    <div class="w-10 h-10 bg-indigo-500/15 rounded-xl flex items-center justify-center mb-5">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <h3 class="font-semibold mb-2">Acceso móvil</h3>
                    <p class="text-white/50 text-sm leading-relaxed">Diseñado para funcionar perfectamente en cualquier dispositivo.</p>
                </div>

                <div class="benefit-card bg-white/[0.03] border border-white/10 rounded-2xl p-8 reveal reveal-delay-2">
                    <div class="w-10 h-10 bg-indigo-500/15 rounded-xl flex items-center justify-center mb-5">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                        </svg>
                    </div>
                    <h3 class="font-semibold mb-2">Boleto inmediato</h3>
                    <p class="text-white/50 text-sm leading-relaxed">Recibe tu tiquete digital al instante después de pagar.</p>
                </div>

                <div class="benefit-card bg-white/[0.03] border border-white/10 rounded-2xl p-8 reveal reveal-delay-3">
                    <div class="w-10 h-10 bg-indigo-500/15 rounded-xl flex items-center justify-center mb-5">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                    </div>
                    <h3 class="font-semibold mb-2">Soporte 24/7</h3>
                    <p class="text-white/50 text-sm leading-relaxed">Nuestro asistente virtual siempre disponible para ayudarte.</p>
                </div>

            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════ CTA FINAL ═══════════════════════════════ -->
    <section class="bg-neutral-950 py-28 reveal">
        <div class="max-w-7xl mx-auto px-8 text-center">
            <p class="text-indigo-400 text-xs uppercase tracking-widest mb-6 font-semibold">¿Listo?</p>
            <h2 class="text-4xl md:text-6xl font-semibold mb-4 leading-tight">
                Tu próximo viaje<br/>
                <span class="text-white/40">comienza aquí</span>
            </h2>
            <p class="text-white/50 mb-10 max-w-md mx-auto">
                Únete a miles de viajeros que ya compran sus tiquetes de forma inteligente.
            </p>
            <a href="/Rutas/Index"
               class="inline-block bg-white text-black px-10 py-4 rounded-full text-sm font-semibold
                      hover:bg-white/90 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-2xl hover:shadow-white/20">
                Buscar rutas ahora
            </a>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="border-t border-white/5 py-8">
        <div class="max-w-7xl mx-auto px-8 flex flex-col md:flex-row justify-between items-center gap-4 text-white/30 text-xs">
            <span class="uppercase tracking-widest font-semibold">Busticket</span>
            <span>© 2025 Busticket. Todos los derechos reservados.</span>
            <a href="/Ayuda" class="hover:text-white/60 transition-colors">Ayuda</a>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script>
        // Reveal on scroll
        const observer = new IntersectionObserver(entries => {
            entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('active'); observer.unobserve(e.target); } });
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        // Header blur on scroll
        window.addEventListener('scroll', () => {
            document.getElementById('header').classList.toggle('header-scrolled', window.scrollY > 40);
        });

        // Hero image subtle zoom on load
        window.addEventListener('load', () => {
            document.getElementById('heroImg').style.transform = 'scale(1)';
        });

        // Mobile menu
        const menuBtn = document.getElementById('menuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        let menuOpen = false;
        menuBtn.addEventListener('click', () => {
            menuOpen = !menuOpen;
            mobileMenu.classList.toggle('-translate-y-full', !menuOpen);
            menuBtn.textContent = menuOpen ? '✕' : '☰';
        });

        // Dropdown perfil
        function toggleDropdown() {
            document.getElementById('profileDropdown').classList.toggle('open');
        }
        document.addEventListener('click', (e) => {
            const wrapper = document.getElementById('profileWrapper');
            if (wrapper && !wrapper.contains(e.target)) {
                document.getElementById('profileDropdown')?.classList.remove('open');
            }
        });

    </script>
</body>
</html>
