@model List<Busticket.Models.Empresa>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

<partial name="_SharedHeader" />

<div class="max-w-6xl mx-auto pt-28 pb-10 px-4">
    <h1 class="text-3xl font-bold mb-6">Listado de Empresas</h1>

    <div class="flex justify-end mb-4">
        <a asp-action="Crear"
           class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg shadow-md transition">
            + Crear Empresa
        </a>
    </div>

    <div class="overflow-hidden rounded-xl shadow-lg border border-gray-200">
        <table class="w-full text-left border-collapse">
            <thead class="bg-gray-100 text-gray-700 uppercase text-sm">
                <tr>
                    <th class="p-4">Nombre</th>
                    <th class="p-4">Nit</th>
                  
                    <th class="p-4 text-center">Acciones</th>
                </tr>
            </thead>

            <tbody class="divide-y divide-gray-200 bg-white">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50 transition">
                        <td class="p-4 font-medium">@item.Nombre</td>
                        <td class="p-4">@item.Nit</td>
                       

                        <td class="p-4 text-center flex items-center justify-center gap-4">
                            <a asp-action="Editar" asp-route-id="@item.EmpresaId"
                               class="text-yellow-600 hover:text-yellow-700 font-medium">Editar</a>

                            <a asp-action="Eliminar" asp-route-id="@item.EmpresaId"
                               class="text-red-600 hover:text-red-700 font-medium">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

</body>
</html>
